{
  "units": [
    {
      "name": "nginx.service",
      "loadState": "loaded",
      "activeState": "active",
      "subState": "running",
      "description": "A high performance web server and a reverse proxy server",
      "fragmentPath": "/lib/systemd/system/nginx.service",
      "unitFileState": "enabled",
      "mainPID": 1200,
      "execStart": "/opt/nginx/sbin/nginx -g daemon on;",
      "workingDirectory": "/",
      "user": "root"
    },
    {
      "name": "ssh.service",
      "loadState": "loaded",
      "activeState": "active",
      "subState": "running",
      "description": "OpenBSD Secure Shell server",
      "fragmentPath": "/lib/systemd/system/ssh.service",
      "unitFileState": "enabled",
      "mainPID": 800,
      "execStart": "/usr/sbin/sshd -D",
      "user": "root"
    },
    {
      "name": "mall-api.service",
      "loadState": "loaded",
      "activeState": "active",
      "subState": "running",
      "description": "Mall API",
      "fragmentPath": "/etc/systemd/system/mall-api.service",
      "unitFileState": "enabled",
      "mainPID": 2100,
      "execStart": "/opt/api/v2/server",
      "workingDirectory": "/opt/api/v2",
      "user": "root"
    }
  ]
}
